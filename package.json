{
  "name": "apodictic-tauri",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the APODICTIC Development Editor — a Tauri 2 build that wraps the APODICTIC-Gemini web app for local, private, file-system-aware use.",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "sync:web": "node scripts/sync-gemini-web.mjs",
    "sync:web:check": "node scripts/sync-gemini-web.mjs --check",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run sync:web && tauri build",
    "packaging:probe": "node scripts/run-macos-packaging-probe.mjs",
    "test:packaging-probe": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "yaml": "^2.8.1"
  }
}
