{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:3001/*"
    ]
  },
  "permissions": [
    "core:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record"
  ]
}
